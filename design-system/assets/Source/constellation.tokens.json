{
  "name": "Constellation",
  "version": "1.0.0",
  "about": "Single source of truth for Constellation's terminal UI (Textual) and web UI (React). Edit this file, then run build_tokens.py; never edit the generated files by hand.",
  "themes": [
    {
      "id": "dark",
      "name": "Dark",
      "dark": true
    },
    {
      "id": "light",
      "name": "Light",
      "dark": false
    }
  ],
  "palette": {
    "ground": {
      "dark": "#0a0c10",
      "light": "#f6f7fa",
      "note": "App background, the night sky.",
      "x256": {
        "dark": 233,
        "light": 255
      }
    },
    "ground-1": {
      "dark": "#0f1218",
      "light": "#ffffff",
      "note": "Pane and canvas body.",
      "x256": {
        "dark": 234,
        "light": 231
      }
    },
    "ground-2": {
      "dark": "#141821",
      "light": "#eef0f5",
      "note": "Sidebars, status bar, status lines.",
      "x256": {
        "dark": 235,
        "light": 254
      }
    },
    "ground-3": {
      "dark": "#1a1f2a",
      "light": "#ffffff",
      "note": "Cards, nodes, menus, dialogs.",
      "x256": {
        "dark": 236,
        "light": 231
      }
    },
    "ground-hover": {
      "dark": "#1e2431",
      "light": "#e7eaf1",
      "note": "Web hover only."
    },
    "ground-sel": {
      "dark": "#26304f",
      "light": "#e3e8fb",
      "note": "Selection and cursor row, tinted with starlight.",
      "x256": {
        "dark": 237,
        "light": 195
      }
    },
    "ink": {
      "dark": "#e3e7ee",
      "light": "#1a1e28"
    },
    "ink-strong": {
      "dark": "#f6f8fc",
      "light": "#07090d"
    },
    "ink-muted": {
      "dark": "#97a0b2",
      "light": "#566074"
    },
    "ink-faint": {
      "dark": "#687186",
      "light": "#7c8496"
    },
    "rule": {
      "dark": "#252b38",
      "light": "#dfe2e9"
    },
    "rule-strong": {
      "dark": "#343c4d",
      "light": "#c9ced8"
    },
    "rule-control": {
      "dark": "#666f85",
      "light": "#7a8396"
    },
    "star": {
      "dark": "#b3c1ff",
      "light": "#3646b3",
      "note": "Starlight: brand, focus, your own voice."
    },
    "sky": {
      "dark": "#5cb4f0",
      "light": "#0b67a6",
      "note": "Work in progress."
    },
    "amber": {
      "dark": "#f5a524",
      "light": "#855300",
      "note": "Needs you. Text form; the fill is amber-fill."
    },
    "vermillion": {
      "dark": "#ff6b45",
      "light": "#b42d0c",
      "note": "Danger and failure."
    },
    "rose": {
      "dark": "#ec8cc4",
      "light": "#a8306f",
      "note": "Forgotten (stale) sessions."
    },
    "green": {
      "dark": "#4cc790",
      "light": "#146e45",
      "note": "Safe and resolved."
    },
    "teal": {
      "dark": "#45c4c4",
      "light": "#0a6c75",
      "note": "Constellation lines: messages between sessions."
    },
    "violet": {
      "dark": "#b994ff",
      "light": "#6b3fd0",
      "note": "Elevated autonomy (accept edits, auto)."
    },
    "slate": {
      "dark": "#8e9ab4",
      "light": "#545f77",
      "note": "Watched, not yours (external sessions)."
    },
    "cobalt": {
      "dark": "#7f97cc",
      "light": "#4a6293",
      "note": "Calm resource readings."
    },
    "amber-fill": {
      "dark": "#f5a524",
      "light": "#f2a228"
    },
    "on-amber-fill": {
      "dark": "#15100a",
      "light": "#15100a"
    },
    "vermillion-fill": {
      "dark": "#ff6b45",
      "light": "#c4320c"
    },
    "on-vermillion-fill": {
      "dark": "#0a0c10",
      "light": "#ffffff"
    },
    "violet-fill": {
      "dark": "#b994ff",
      "light": "#6b3fd0"
    },
    "on-violet-fill": {
      "dark": "#0a0c10",
      "light": "#ffffff"
    },
    "star-fill": {
      "dark": "#b3c1ff",
      "light": "#3949b8"
    },
    "on-star-fill": {
      "dark": "#0a0c10",
      "light": "#ffffff"
    }
  },
  "tokens": [
    {
      "group": "Surfaces",
      "name": "bg",
      "ref": "ground",
      "role": "surface",
      "ansi": "default",
      "textual": "background",
      "usage": "App background behind everything; the sky the map floats on."
    },
    {
      "group": "Surfaces",
      "name": "surface",
      "ref": "ground-1",
      "role": "surface",
      "ansi": "default",
      "textual": "surface",
      "usage": "Pane bodies, conversation and map canvas."
    },
    {
      "group": "Surfaces",
      "name": "panel",
      "ref": "ground-2",
      "role": "surface",
      "ansi": "default",
      "textual": "panel",
      "usage": "Tree sidebar, global status bar, pane status lines, prompt box."
    },
    {
      "group": "Surfaces",
      "name": "raised",
      "ref": "ground-3",
      "role": "surface",
      "ansi": "default",
      "usage": "Session nodes, question and permission cards, menus, dialogs. Light theme sets it apart with line-strong, not shade."
    },
    {
      "group": "Surfaces",
      "name": "hover",
      "ref": "ground-hover",
      "role": "surface",
      "ansi": "default",
      "usage": "Web pointer hover on rows and chips. The TUI has no hover state."
    },
    {
      "group": "Surfaces",
      "name": "selection",
      "ref": "ground-sel",
      "role": "surface",
      "ansi": "default",
      "ansi_style": "reverse",
      "usage": "Selected rows, the tree cursor, chosen options, multi-select picks. 16-color: reverse video."
    },
    {
      "group": "Text",
      "name": "fg",
      "ref": "ink",
      "role": "text",
      "ansi": "default",
      "textual": "foreground",
      "usage": "Body text and conversation, on bg, surface, panel, raised and selection."
    },
    {
      "group": "Text",
      "name": "fg-strong",
      "ref": "ink-strong",
      "role": "text",
      "ansi": "default",
      "ansi_style": "bold",
      "usage": "Session names, the focused pane title, chosen values; always bold. On every surface."
    },
    {
      "group": "Text",
      "name": "fg-muted",
      "ref": "ink-muted",
      "role": "text",
      "ansi": "default",
      "ansi_style": "dim",
      "usage": "Metadata (project, branch, times, counts), tool output, secondary labels; the TUI's dim. On every surface."
    },
    {
      "group": "Text",
      "name": "fg-faint",
      "ref": "ink-faint",
      "role": "mark",
      "ansi": "default",
      "ansi_style": "dim",
      "usage": "Disabled controls, tree guides, separators. Never for text someone has to read (placeholders, filtered-out rows, switched-off chips take fg-muted): 3:1 only."
    },
    {
      "group": "Lines",
      "name": "line",
      "ref": "rule",
      "role": "decor",
      "ansi": "default",
      "ansi_style": "dim",
      "usage": "Unfocused pane borders and hairline dividers. Decorative; position already says where a pane ends."
    },
    {
      "group": "Lines",
      "name": "line-strong",
      "ref": "rule-strong",
      "role": "decor",
      "ansi": "default",
      "ansi_style": "dim",
      "usage": "Card and node outlines in the light theme, menu borders, context-bar track."
    },
    {
      "group": "Lines",
      "name": "line-control",
      "ref": "rule-control",
      "role": "mark",
      "ansi": "default",
      "usage": "Borders that identify a control: prompt box, inputs, option boxes. 3:1 on every surface."
    },
    {
      "group": "Focus",
      "name": "focus",
      "ref": "star",
      "role": "mark",
      "ansi": "default",
      "ansi_style": "bold",
      "textual": "primary",
      "usage": "Focused pane border (TUI heavy line, web 2px), focus ring, tree cursor bar. 16-color: heavy border + bold title."
    },
    {
      "group": "Focus",
      "name": "brand",
      "ref": "star",
      "role": "text",
      "ansi": "blue",
      "usage": "The wordmark and the prefix indicator. Never decoration."
    },
    {
      "group": "Focus",
      "name": "fill-brand",
      "ref": "star-fill",
      "role": "fill",
      "on": "on-fill-brand",
      "ansi": "blue",
      "ansi_style": "bold",
      "usage": "Prefix-active indicator and the primary action in a dialog."
    },
    {
      "group": "Focus",
      "name": "on-fill-brand",
      "ref": "on-star-fill",
      "role": "on",
      "ansi": "bright_white",
      "usage": "Text on fill-brand.",
      "ansi_style": "bold"
    },
    {
      "group": "Status",
      "name": "status-working",
      "ref": "sky",
      "role": "text",
      "ansi": "blue",
      "usage": "● working: the glyph, the word, the activity spinner. On every surface."
    },
    {
      "group": "Status",
      "name": "status-waiting",
      "ref": "amber",
      "role": "text",
      "ansi": "yellow",
      "ansi_style": "bold",
      "usage": "Text form of ? needs you, for flags inside a line. Prefer the fill."
    },
    {
      "group": "Status",
      "name": "status-waiting-fill",
      "ref": "amber-fill",
      "role": "fill",
      "on": "on-status-waiting-fill",
      "ansi": "yellow",
      "ansi_style": "bold",
      "textual": "warning",
      "usage": "The ? needs you chip. The only amber fill in the product: if it is amber and filled, a session is waiting for you."
    },
    {
      "group": "Status",
      "name": "on-status-waiting-fill",
      "ref": "on-amber-fill",
      "role": "on",
      "ansi": "black",
      "usage": "Text on status-waiting-fill.",
      "ansi_style": "bold"
    },
    {
      "group": "Status",
      "name": "status-idle",
      "ref": "ink-muted",
      "role": "text",
      "ansi": "default",
      "ansi_style": "dim",
      "usage": "○ idle: finished its turn, nothing pending."
    },
    {
      "group": "Status",
      "name": "status-stale",
      "ref": "rose",
      "role": "text",
      "ansi": "magenta",
      "usage": "◌ stale: idle past the forgotten threshold (default 30 min). Glyph, word and age in rose."
    },
    {
      "group": "Status",
      "name": "status-error",
      "ref": "vermillion",
      "role": "text",
      "ansi": "red",
      "ansi_style": "bold",
      "textual": "error",
      "usage": "× error: the turn or the process failed."
    },
    {
      "group": "Status",
      "name": "status-stopped",
      "ref": "ink-muted",
      "role": "text",
      "ansi": "default",
      "ansi_style": "dim",
      "usage": "■ stopped: exiting or exited; shown in the launcher and resume picker, then leaves the map."
    },
    {
      "group": "Modes",
      "name": "mode-default",
      "ref": "ink-muted",
      "role": "text",
      "ansi": "default",
      "usage": "· default (Claude Code's manual): asks before edits and commands."
    },
    {
      "group": "Modes",
      "name": "mode-plan",
      "ref": "green",
      "role": "text",
      "ansi": "green",
      "usage": "‖ plan: reads only until you approve a plan."
    },
    {
      "group": "Modes",
      "name": "mode-edits",
      "ref": "violet",
      "role": "text",
      "ansi": "magenta",
      "usage": "± accept edits: file edits go through without asking."
    },
    {
      "group": "Modes",
      "name": "mode-auto",
      "ref": "violet-fill",
      "role": "fill",
      "on": "on-mode-auto",
      "ansi": "magenta",
      "ansi_style": "bold",
      "usage": "» auto: a classifier approves most actions. Filled chip: runs commands without you."
    },
    {
      "group": "Modes",
      "name": "on-mode-auto",
      "ref": "on-violet-fill",
      "role": "on",
      "ansi": "bright_white",
      "usage": "Text on mode-auto.",
      "ansi_style": "bold"
    },
    {
      "group": "Modes",
      "name": "mode-bypass",
      "ref": "vermillion-fill",
      "role": "fill",
      "on": "on-mode-bypass",
      "ansi": "red",
      "ansi_style": "bold",
      "usage": "! bypass permissions: nothing is checked. Filled vermillion chip plus the hazard edge on the pane and node."
    },
    {
      "group": "Modes",
      "name": "on-mode-bypass",
      "ref": "on-vermillion-fill",
      "role": "on",
      "ansi": "bright_white",
      "usage": "Text on mode-bypass.",
      "ansi_style": "bold"
    },
    {
      "group": "Modes",
      "name": "mode-dontask",
      "ref": "slate",
      "role": "text",
      "ansi": "cyan",
      "usage": "∅ don't ask: never waits; anything that would ask is denied. Shown with a denied count."
    },
    {
      "group": "Messages",
      "name": "msg-prompt",
      "ref": "star",
      "role": "text",
      "ansi": "default",
      "ansi_style": "bold",
      "usage": "› your prompt (one per turn). Starlight is your voice."
    },
    {
      "group": "Messages",
      "name": "msg-slash",
      "ref": "star",
      "role": "text",
      "ansi": "default",
      "ansi_style": "bold",
      "usage": "/ slash command you ran."
    },
    {
      "group": "Messages",
      "name": "msg-tool",
      "ref": "sky",
      "role": "text",
      "ansi": "blue",
      "usage": "λ tool call (Bash, Edit, Read, Agent …): the glyph and tool name; arguments stay fg-muted."
    },
    {
      "group": "Messages",
      "name": "msg-question",
      "ref": "amber",
      "role": "text",
      "ansi": "yellow",
      "usage": "? question or permission asked. Bold while unanswered."
    },
    {
      "group": "Messages",
      "name": "msg-answer",
      "ref": "green",
      "role": "text",
      "ansi": "green",
      "usage": "✓ question answered, permission allowed."
    },
    {
      "group": "Messages",
      "name": "msg-denied",
      "ref": "vermillion",
      "role": "text",
      "ansi": "red",
      "usage": "× permission denied, tool failed."
    },
    {
      "group": "Messages",
      "name": "msg-sent",
      "ref": "teal",
      "role": "text",
      "ansi": "cyan",
      "usage": "→ message sent to another session."
    },
    {
      "group": "Messages",
      "name": "msg-received",
      "ref": "teal",
      "role": "text",
      "ansi": "cyan",
      "usage": "← message received from another session (also every message to an external session from you)."
    },
    {
      "group": "Messages",
      "name": "msg-subagent",
      "ref": "teal",
      "role": "text",
      "ansi": "cyan",
      "usage": "◦ subagent started, ↑ subagent reported back."
    },
    {
      "group": "Messages",
      "name": "msg-reply",
      "ref": "ink",
      "role": "text",
      "ansi": "default",
      "usage": "¶ the agent's reply text."
    },
    {
      "group": "Resources",
      "name": "res-normal",
      "ref": "cobalt",
      "role": "mark",
      "ansi": "default",
      "usage": "Sparkline bars and context fill below the warning threshold."
    },
    {
      "group": "Resources",
      "name": "res-warning",
      "ref": "amber",
      "role": "text",
      "ansi": "yellow",
      "usage": "△ warning: context ≥ 80 %, CPU busy > 5 min, memory/GPU ≥ 80 % of its limit. Text and bars, never a fill."
    },
    {
      "group": "Resources",
      "name": "res-critical",
      "ref": "vermillion",
      "role": "text",
      "ansi": "red",
      "ansi_style": "bold",
      "usage": "▲ critical: context ≥ 95 %, a limit passed. Bars and text."
    },
    {
      "group": "Resources",
      "name": "res-critical-fill",
      "ref": "vermillion-fill",
      "role": "fill",
      "on": "on-res-critical-fill",
      "ansi": "red",
      "ansi_style": "bold",
      "usage": "The ▲ chip in the status bar and on nodes when a limit is passed."
    },
    {
      "group": "Resources",
      "name": "on-res-critical-fill",
      "ref": "on-vermillion-fill",
      "role": "on",
      "ansi": "bright_white",
      "usage": "Text on res-critical-fill.",
      "ansi_style": "bold"
    },
    {
      "group": "Resources",
      "name": "res-track",
      "ref": "rule-strong",
      "role": "decor",
      "ansi": "default",
      "ansi_style": "dim",
      "usage": "Empty part of the context bar and sparkline baseline."
    },
    {
      "group": "Kinds",
      "name": "kind-managed",
      "ref": "star",
      "role": "mark",
      "ansi": "default",
      "ansi_style": "bold",
      "usage": "◆ managed (started here, full control): the glyph; node and pane borders stay solid."
    },
    {
      "group": "Kinds",
      "name": "kind-external",
      "ref": "slate",
      "role": "text",
      "ansi": "cyan",
      "usage": "◇ external (started elsewhere, watched): the glyph, the ext tag and the dashed border."
    },
    {
      "group": "Links",
      "name": "edge",
      "ref": "teal",
      "role": "mark",
      "ansi": "cyan",
      "usage": "Message edges on the map and link lanes in the TUI; weight shows volume."
    },
    {
      "group": "Links",
      "name": "edge-subagent",
      "ref": "slate",
      "role": "mark",
      "ansi": "default",
      "ansi_style": "dim",
      "usage": "Parent to subagent links (dotted)."
    }
  ],
  "glyphs": {
    "note": "unicode = default tier (renders in DejaVu Sans Mono, JetBrains Mono, Hack, Fira Code, Source Code Pro or falls back cleanly); ascii = fallback when CONSTELLATION_GLYPHS=ascii or the locale is not UTF-8; nerd = optional, only when a Nerd Font is configured.",
    "status": {
      "working": {
        "unicode": "●",
        "ascii": "*",
        "nerd": "",
        "label": "working"
      },
      "waiting": {
        "unicode": "?",
        "ascii": "?",
        "nerd": "",
        "label": "needs you"
      },
      "idle": {
        "unicode": "○",
        "ascii": "o",
        "nerd": "",
        "label": "idle"
      },
      "stale": {
        "unicode": "◌",
        "ascii": "~",
        "nerd": "",
        "label": "stale"
      },
      "error": {
        "unicode": "×",
        "ascii": "x",
        "nerd": "",
        "label": "error"
      },
      "stopped": {
        "unicode": "■",
        "ascii": "#",
        "nerd": "",
        "label": "stopped"
      }
    },
    "spinner": {
      "unicode": [
        "▖",
        "▘",
        "▝",
        "▗"
      ],
      "ascii": [
        "-",
        "\\",
        "|",
        "/"
      ],
      "interval_ms": 120
    },
