{
  "$defs": {
    "AnswerRequest": {
      "additionalProperties": false,
      "description": "Answer a pending request. For a question, `updated_input` carries the tool input plus `answers`.",
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why it was denied: the session reads this."
        },
        "updatedInput": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remember": {
          "default": false,
          "description": "Allow and remember: add Claude Code's suggested allow rule.",
          "type": "boolean"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "default",
                "plan",
                "acceptEdits",
                "auto",
                "bypassPermissions",
                "dontAsk"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plan approval: the mode to work in afterwards, such as acceptEdits."
        }
      },
      "required": [
        "allow",
        "message",
        "updatedInput",
        "remember",
        "mode"
      ],
      "title": "AnswerRequest",
      "type": "object"
    },
    "CommandInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "argumentHint": {
          "default": "",
          "type": "string"
        },
        "source": {
          "enum": [
            "built-in",
            "skill",
            "command",
            "mcp",
            "plugin"
          ],
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unavailable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why it can't run here: 'terminal-only'."
        }
      },
      "required": [
        "name",
        "description",
        "argumentHint",
        "source",
        "aliases",
        "unavailable"
      ],
      "title": "CommandInfo",
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "usedTokens": {
          "type": "integer"
        },
        "windowTokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model",
        "usedTokens",
        "windowTokens",
        "percent"
      ],
      "title": "Context",
      "type": "object"
    },
    "ContextCategory": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tokens": {
          "type": "integer"
        },
        "kind": {
          "description": "used, deferred (not in the window yet), buffer or free.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "tokens",
        "kind"
      ],
      "title": "ContextCategory",
      "type": "object"
    },
    "ContextUsage": {
      "additionalProperties": false,
      "description": "The /context breakdown (get_context_usage).",
      "properties": {
        "model": {
          "type": "string"
        },
        "totalTokens": {
          "type": "integer"
        },
        "maxTokens": {
          "type": "integer"
        },
        "percent": {
          "type": "number"
        },
        "autoCompact": {
          "type": "boolean"
        },
        "compactAt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where auto-compact fires, as a share of the window."
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/ContextCategory"
          },
          "type": "array"
        },
        "memoryFiles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MemoryFile"
          },
          "type": "array"
        }
      },
      "required": [
        "model",
        "totalTokens",
        "maxTokens",
        "percent",
        "autoCompact",
        "compactAt",
        "categories",
        "memoryFiles"
      ],
      "title": "ContextUsage",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "description": "Session id or endpoint id.",
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "lastAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lastSummary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "msgIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "count",
        "lastAt",
        "lastSummary",
        "msgIds"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EffortRequest": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        }
      },
      "required": [
        "effort"
      ],
      "title": "EffortRequest",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "description": "A message peer that isn't a running session: one that exited, or a non-Claude sender.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "addresses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "addresses"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "EntriesEvent": {
      "additionalProperties": false,
      "description": "New or updated entries (upsert by id). `reset`: too many to send; drop the cache and refetch.",
      "properties": {
        "type": {
          "const": "entries",
          "default": "entries",
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/Entry"
          },
          "type": "array"
        },
        "reset": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "session",
        "entries",
        "reset"
      ],
      "title": "EntriesEvent",
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "description": "One line of the message tree and the conversation. Full content: GET .../entries/{id}.",
      "properties": {
        "id": {
          "type": "string"
        },
        "seq": {
          "description": "Position in the session, across /clear.",
          "type": "integer"
        },
        "turn": {
          "description": "Turn number; 0 before the first prompt.",
          "type": "integer"
        },
        "starter": {
          "description": "Starts a turn: a top-level row under the session in the tree.",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "prompt",
            "slash",
            "tool",
            "question",
            "answer",
            "denied",
            "sent",
            "received",
            "subagent_started",
            "subagent_reported",
            "reply",
            "thinking",
            "interrupt",
            "compact",
            "notice"
          ],
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "description": "First line: the prompt, tool name, peer name or reply text.",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Muted remainder: arguments, file, preview."
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "toolUseId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resultError": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resultPreview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "peer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For sent/received: the other side's name or address."
        },
        "msgId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "agentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sessionId": {
          "description": "The transcript this entry is in.",
          "type": "string"
        },
        "abandoned": {
          "default": false,
          "description": "On a branch a rewind left: not part of the conversation any more.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "seq",
        "turn",
        "starter",
        "kind",
        "at",
        "text",
        "detail",
        "tool",
        "toolUseId",
        "resultError",
        "resultPreview",
        "peer",
        "msgId",
        "agentId",
        "sessionId",
        "abandoned"
      ],
      "title": "Entry",
      "type": "object"
    },
    "EntryContent": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "$ref": "#/$defs/Entry"
        },
        "text": {
          "description": "Everything the entry says, untruncated up to a size cap.",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tool input as pretty JSON."
        },
        "result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tool result text."
        },
        "truncated": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "entry",
        "text",
        "input",
        "result",
        "truncated"
      ],
      "title": "EntryContent",
      "type": "object"
    },
    "EntryPage": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/Entry"
          },
          "type": "array"
        },
        "hasBefore": {
          "type": "boolean"
        },
        "hasAfter": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "hasBefore",
        "hasAfter"
      ],
      "title": "EntryPage",
      "type": "object"
    },
    "ForkRequest": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "ForkRequest",
      "type": "object"
    },
    "GraphEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "graph",
          "default": "graph",
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        },
        "endpoints": {
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "type": "array"
        },
        "subagents": {
          "items": {
            "$ref": "#/$defs/Subagent"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "edges",
        "endpoints",
        "subagents"
      ],
      "title": "GraphEvent",
      "type": "object"
    },
    "HookStatus": {
      "additionalProperties": false,
      "properties": {
        "installed": {
          "type": "boolean"
        },
        "settings": {
          "description": "The settings file the hooks go in.",
          "type": "string"
        },
        "script": {
          "description": "The hook script.",
          "type": "string"
        }
      },
      "required": [
        "installed",
        "settings",
        "script"
      ],
      "title": "HookStatus",
      "type": "object"
    },
    "ImageInput": {
      "additionalProperties": false,
      "properties": {
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ],
          "type": "string"
        },
        "data": {
          "description": "Base64, up to 5 MB decoded (the API's limit per image).",
          "maxLength": 7000000,
          "type": "string"
        }
      },
      "required": [
        "mediaType",
        "data"
      ],
      "title": "ImageInput",
      "type": "object"
    },
    "LinkMessage": {
      "additionalProperties": false,
      "description": "A message between two sessions, as one of them recorded it.",
      "properties": {
        "session": {
          "description": "Node id of the session whose transcript has it.",
          "type": "string"
        },
        "entry": {
          "$ref": "#/$defs/Entry"
        }
      },
      "required": [
        "session",
        "entry"
      ],
      "title": "LinkMessage",
      "type": "object"
    },
    "McpServer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "connected",
            "failed",
            "needs-auth",
            "pending",
            "disabled"
          ],
          "type": "string"
        },
        "tools": {
          "default": 0,
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "status",
        "tools",
        "error",
        "scope"
      ],
      "title": "McpServer",
      "type": "object"
    },
    "McpSummary": {
      "additionalProperties": false,
      "properties": {
        "connected": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "connected",
        "failed",
        "total"
      ],
      "title": "McpSummary",
      "type": "object"
    },
    "MemoryFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "tokens": {
          "type": "integer"
        }
      },
      "required": [
        "path",
        "tokens"
      ],
      "title": "MemoryFile",
      "type": "object"
    },
    "MessageRequest": {
      "additionalProperties": false,
      "description": "A peer message to a session Constellation didn't start.",
      "properties": {
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "MessageRequest",
      "type": "object"
    },
    "ModeRequest": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "default",
            "plan",
            "acceptEdits",
            "auto",
            "bypassPermissions",
            "dontAsk"
          ],
          "type": "string"
        },
        "confirm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bypass only: the session's name, the second key that names it."
        }
      },
      "required": [
        "mode",
        "confirm"
      ],
      "title": "ModeRequest",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "What set_model takes: an alias ('opus') or a model id.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The model id the alias resolves to."
        },
        "efforts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "value",
        "name",
        "description",
        "model",
        "efforts"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "ModelRequest": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "title": "ModelRequest",
      "type": "object"
    },
    "PastSession": {
      "additionalProperties": false,
      "description": "A session in the resume picker (list_sessions).",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modified": {
          "description": "Unix ms.",
          "type": "integer"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "firstPrompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "running": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Node id, when a live process has this session open."
        }
      },
      "required": [
        "sessionId",
        "name",
        "project",
        "cwd",
        "modified",
        "tag",
        "firstPrompt",
        "branch",
        "running"
      ],
      "title": "PastSession",
      "type": "object"
    },
    "PendingRequest": {
      "additionalProperties": false,
      "description": "A question, permission prompt or plan approval a session is waiting on.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "question",
            "permission",
            "plan"
          ],
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "description": "The tool's input: for a question, its `questions` list.",
          "type": "object"
        },
        "rules": {
          "description": "What 'allow and remember' saves: `Bash(touch x)`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "at": {
          "description": "Unix ms.",
          "type": "integer"
        },
        "source": {
          "default": "sdk",
          "description": "sdk: a managed session's, answered here. hook, transcript: a terminal session's, answered there.",
          "enum": [
            "sdk",
            "hook",
            "transcript"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "tool",
        "input",
        "rules",
        "at",
        "source"
      ],
      "title": "PendingRequest",
      "type": "object"
    },
    "PreviewLine": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "prompt",
            "reply"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "PreviewLine",
      "type": "object"
    },
    "PromptRequest": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200000,
          "type": "string"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/ImageInput"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "text",
        "images"
      ],
      "title": "PromptRequest",
      "type": "object"
    },
    "Queued": {
      "additionalProperties": false,
      "properties": {
        "queued": {
          "description": "Prompts still waiting after this one: 0 means it was sent now.",
          "type": "integer"
        }
      },
      "required": [
        "queued"
      ],
      "title": "Queued",
      "type": "object"
    },
    "RenameRequest": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
